{
  "name": "dharvin",
  "version": "1.0.0",
  "description": "CycleCare Full-Stack Application",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix cyclecare-frontend run build",
    "dev:frontend": "npm --prefix cyclecare-frontend run dev",
    "dev:backend": "npm --prefix cyclecare-backend run dev",
    "seed": "npm --prefix cyclecare-backend run seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
